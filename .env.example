############
# Core secrets (required)
############

# Shared Postgres instance used by Langfuse
POSTGRES_PASSWORD=change-me

# Langfuse storage backends
CLICKHOUSE_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
LANGFUSE_SALT=change-me
NEXTAUTH_SECRET=change-me
ENCRYPTION_KEY=change-me

############
# Optional Caddy hostnames (for production TLS)
############

# WEBUI_HOSTNAME=openwebui.yourdomain.com
# FLOWISE_HOSTNAME=flowise.yourdomain.com
# OLLAMA_HOSTNAME=ollama.yourdomain.com
# QDRANT_HOSTNAME=qdrant.yourdomain.com
# SEARXNG_HOSTNAME=searxng.yourdomain.com
# LANGFUSE_HOSTNAME=langfuse.yourdomain.com
# LETSENCRYPT_EMAIL=admin@example.com

############
# Optional Langfuse bootstrap values
############

# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_ORG_NAME=
# LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_NAME=
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=
# LANGFUSE_INIT_USER_PASSWORD=

############
# Optional tuning
############

# TELEMETRY_ENABLED=false
# LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
# LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
# LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
# LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
# SEARXNG_UWSGI_WORKERS=4
# SEARXNG_UWSGI_THREADS=4
